# Pinterest API - Render env template
# Copy to the Render dashboard. Never commit real values.

PIN_DATA_DIR=/data
PIN_COOKIES_B64=<paste content of PIN_COOKIES_B64.txt, one line>
PIN_POOL_API=http://127.0.0.1:8899
PIN_LOGIN_COUNTRY=IN
PIN_LOGIN_MIN_INTERVAL=600
PIN_LOGIN_MAX_PER_DAY=5
PIN_LOGIN_COOLDOWN=21600
PIN_LOGIN_MAX_PROXIES=2
PIN_STICKY_EGRESS=0
API_TOKEN=<long random string>

# Optional (avoid storing the password in the cloud when possible)
# PIN_EMAIL=testflowthrowout@gmail.com
# PIN_PASSWORD=<current password>
# PIN_PROXY=socks5://host:port
# RUN_POOL=1
